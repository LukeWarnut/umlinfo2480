<bx:output>
<bx:param name="articleId" default="-1" />
<bx:set articleService = new finalproject.common.Articles() />

<bx:if form.keyExists("title")>
    <bx:set form.active = form.keyExists("active") ? form.active : 0 />
    <bx:set articleService.saveArticle(form.title, form.description, form.active, form.articleId) />
</bx:if>

<bx:set allArticles = articleService.allArticles() />

<div class="row">
    <div class="col-sm-3">
        <ul class="list-group">
            <li>
                <a href="#cgi.script_name#?tool=manageArticles&articleId=0">
                    New
                </a>
            </li>
            <bx:loop array="#allArticles#" index="article">
                <li>
                    <a href="#cgi.script_name#?tool=manageArticles&articleId=#article.id#">
                        #article.title#
                    </a>
                </li>
            </bx:loop>
        </ul>
    </div>
    <div class="col-sm-9">
        <bx:if articleId gt -1>
            <bx:set articles = articleService.getArticleById(articleId) />
            <bx:set articleData = articles.len() ? articles[1] : {"id":0,"title":"","description":"","status":0} />
            <form method="POST" action="#cgi.script_name#" >
                <input type="hidden" name="articleId" value="#articleData.id#" />
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="floatingInput" placeholder="Article Title" name="title" value="#articleData.title#">
                    <label for="floatingInput">Title</label>
                </div>
                <div class="form-floating">
                    <textarea class="form-control" placeholder="Leave a comment here" id="floatingTextarea" name="description">#articleData.description#</textarea>
                    <label for="floatingTextarea">Content</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="1" id="checkDefault" name="active" #articleData.status==1 ? "checked" : ""#>
                    <label class="form-check-label" for="checkDefault">
                        Active
                    </label>
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </form>
        </bx:if>
    </div>
</div>
</bx:output>